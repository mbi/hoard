[Unit]
Description=hoard django-rq worker %i
After=network.target

[Service]
Type=simple
User=hoard
Group=hoard
WorkingDirectory=/home/projects/hoard/hoard/hoard
ExecStart=/home/projects/hoard/hoard/.venv/bin/python manage.py rqworker
Environment=LANG=en_US.UTF-8
Environment=LC_ALL=en_US.UTF-8
Environment=LC_LANG=en_US.UTF-8
ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s TERM $MAINPID
PrivateTmp=true
Restart=always

[Install]
WantedBy=multi-user.target
